{
    "name": "@vuecs/table-card",
    "version": "0.1.0",
    "type": "module",
    "description": "Collection card for vuecs — a card frame around a table with title, search, actions, pagination and empty / no-results states.",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "vue",
        "vuecs",
        "table",
        "card",
        "collection",
        "pagination",
        "search"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/vuecs.git",
        "directory": "packages/table-card"
    },
    "scripts": {
        "build:js": "tsdown",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
        "build": "rimraf dist && npm run build:js && npm run build:types",
        "test": "npm run build:types && vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "devDependencies": {
        "@vue/test-utils": "^2.6.0",
        "@vuecs/core": "^3.6.1",
        "@vuecs/data": "^1.0.0-alpha.2",
        "@vuecs/elements": "^1.7.0",
        "@vuecs/forms": "^5.5.0",
        "@vuecs/pagination": "^2.2.3",
        "@vuecs/table": "^1.6.3",
        "jsdom": "^30.1.3",
        "vue": "^3.5.46"
    },
    "peerDependencies": {
        "@vuecs/core": "^3.6.1",
        "@vuecs/elements": "^1.7.0",
        "@vuecs/forms": "^5.5.0",
        "@vuecs/pagination": "^2.2.3",
        "@vuecs/table": "^1.6.3",
        "vue": "^3.x"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
