{
    "name": "@vuecs/tree",
    "version": "1.0.1",
    "type": "module",
    "description": "Tree view component for vuecs — nested items, key-based selection, expand/collapse, cascade and WAI-ARIA keyboard navigation.",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "style": "./dist/style.css",
            "import": "./dist/index.mjs"
        },
        "./style.css": "./dist/style.css",
        "./dist/style.css": "./dist/style.css"
    },
    "style": "./dist/style.css",
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/*.css"
    ],
    "keywords": [
        "vue",
        "vuecs",
        "tree",
        "treeview",
        "component"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/vuecs.git",
        "directory": "packages/tree"
    },
    "scripts": {
        "build:js": "tsdown",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
        "build": "rimraf dist && npm run build:js && npm run build:types",
        "test": "vitest --config test/vitest.config.ts --run"
    },
    "dependencies": {
        "reka-ui": "^2.11.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vuecs/core": "^3.6.1",
        "jsdom": "^30.1.3",
        "vue": "^3.5.44"
    },
    "peerDependencies": {
        "@vuecs/core": "^3.6.1",
        "vue": "^3.x"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
